# Optional public Privy identifiers for sign-in and game transactions. Never
# place secrets, delegated signer IDs, or authorization keys in frontend
# configuration. Use the shared App ID when wallet access is enabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Required for public reads from the disposable Burntato deployment. It must
# be an absolute, credential-free HTTP(S) URL. Without Privy, the app remains
# a live read-only spectator experience.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
