# Public Privy identifiers only. Never place secrets, App IDs with privileged
# keys, delegated signer IDs, or authorization keys in frontend configuration.
# The deployed app must use the same Privy App ID as the other applications.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Required public RPC endpoints for the wallet runtime. Each must be an
# absolute, credential-free HTTP(S) URL. The app stays in its safe unsigned
# wallet state and logs which variables are missing or invalid when any of
# these are absent, instead of silently using chain-default public RPCs.
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
