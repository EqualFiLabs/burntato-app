# Optional public Privy identifiers for sign-in and game transactions. Never
# place secrets, delegated signer IDs, or authorization keys in frontend
# configuration. Use the shared App ID when wallet access is enabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Required for public reads from the Robinhood testnet Burntato deployment. It must
# be an absolute, credential-free HTTP(S) URL. Without Privy, the app remains
# a live read-only spectator experience.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional durable history endpoint. When absent or unhealthy, the app labels
# and uses a bounded direct-RPC fallback; eligibility reads remain onchain.
NEXT_PUBLIC_BURNTATO_INDEXER_URL=
