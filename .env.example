# Optional public Privy identifiers for sign-in and game transactions. Never
# place secrets, delegated signer IDs, or authorization keys in frontend
# configuration. Use the shared App ID when wallet access is enabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Required for public reads from the configured Burntato deployment. It must be
# an absolute, credential-free HTTP(S) URL. Without Privy, the app remains a
# live read-only spectator experience.
NEXT_PUBLIC_BURNTATO_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Leave these unset for the pinned Robinhood testnet deployment. A different
# chain requires the full address set so the app cannot silently mix deployments.
# NEXT_PUBLIC_BURNTATO_NETWORK=
# NEXT_PUBLIC_BURNTATO_CHAIN_ID=
# NEXT_PUBLIC_BURNTATO_DEPLOYMENT_ID=
# NEXT_PUBLIC_BURNTATO_EXPLORER_URL=
# NEXT_PUBLIC_BURNTATO_DIAMOND_ADDRESS=
# NEXT_PUBLIC_BURNTATO_DEPLOYMENT_BLOCK=
# NEXT_PUBLIC_BURNTATO_SOURCE_COMMIT=
# NEXT_PUBLIC_BURNTATO_OPERATOR_REWARDS_ROUTER_ADDRESS=
# NEXT_PUBLIC_BURNTATO_HOOK_ADDRESS=
# NEXT_PUBLIC_BURNTATO_STATICS_ADDRESS=
# NEXT_PUBLIC_BURNTATO_OPERATOR_NFT_ADDRESS=
# NEXT_PUBLIC_BURNTATO_OPERATOR_NFT_DEPLOYMENT_BLOCK=
# NEXT_PUBLIC_BURNTATO_ACTIVATION_REGISTRY_ADDRESS=
# NEXT_PUBLIC_BURNTATO_WETH_ADDRESS=
# NEXT_PUBLIC_BURNTATO_POOL_MANAGER_ADDRESS=
# NEXT_PUBLIC_BURNTATO_QUOTER_ADDRESS=
# NEXT_PUBLIC_BURNTATO_UNIVERSAL_ROUTER_ADDRESS=
# NEXT_PUBLIC_BURNTATO_PERMIT2_ADDRESS=

# Optional durable history endpoint. When absent or unhealthy, the app labels
# and uses a bounded direct-RPC fallback; eligibility reads remain onchain.
NEXT_PUBLIC_BURNTATO_INDEXER_URL=
