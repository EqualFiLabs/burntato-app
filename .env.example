# Public Privy identifiers only. Never place secrets, App IDs with privileged
# keys, delegated signer IDs, or authorization keys in frontend configuration.
# The deployed app must use the same Privy App ID as the other applications.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
