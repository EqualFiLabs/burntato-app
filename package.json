  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fork": "vitest run lib/robinhood-fork-flow.test.ts",
    "test:live": "vitest run lib/robinhood-live.test.ts",
