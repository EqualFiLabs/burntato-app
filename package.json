    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.27.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.10",
    "wagmi": "3.7.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
