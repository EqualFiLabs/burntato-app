# Run each deployment in its own database schema. Never point two Ponder apps
# at the same schema.
PONDER_RPC_URL_46630=https://rpc.testnet.chain.robinhood.com
PONDER_DATABASE_DIRECTORY=.ponder/robinhood-testnet
PONDER_ALLOWED_ORIGIN=http://localhost:3000

# Use DATABASE_URL plus a unique DATABASE_SCHEMA in hosted environments.
DATABASE_URL=
DATABASE_SCHEMA=burntato_robinhood_testnet_46630
